<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hot-reloadable bridge modules. Deployed as .bin so the game's mod loader
       ignores it; the TimberLive.Bridge shim loads it and POST /api/dev/reload swaps it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TimberLive.Bridge.Logic</AssemblyName>
    <RootNamespace>TimberLive.Bridge.Logic</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Timberborn</GameDir>
    <GameManaged>$(GameDir)\Timberborn_Data\Managed</GameManaged>
    <ModDeployDir>$(USERPROFILE)\Documents\Timberborn\Mods\TimberLive.Bridge</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimberLive.Bridge\TimberLive.Bridge.csproj" Private="false" />
    <Reference Include="$(GameManaged)\Timberborn.*.dll" Private="false" />
    <Reference Include="$(GameManaged)\Bindito.*.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.Collections.Immutable.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployLogic" AfterTargets="Build">
    <MakeDir Directories="$(ModDeployDir)\Logic" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(ModDeployDir)\Logic\TimberLive.Bridge.Logic.bin" />
  </Target>

</Project>
