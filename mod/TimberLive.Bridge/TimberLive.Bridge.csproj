<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TimberLive.Bridge</AssemblyName>
    <RootNamespace>TimberLive.Bridge</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Timberborn</GameDir>
    <GameManaged>$(GameDir)\Timberborn_Data\Managed</GameManaged>
    <ModDeployDir>$(USERPROFILE)\Documents\Timberborn\Mods\TimberLive.Bridge</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameManaged)\Timberborn.*.dll" Private="false" />
    <Reference Include="$(GameManaged)\Bindito.*.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(GameManaged)\System.Collections.Immutable.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build">
    <MakeDir Directories="$(ModDeployDir)\Scripts" />
    <Copy SourceFiles="manifest.json" DestinationFolder="$(ModDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)\Scripts" />
  </Target>

</Project>
